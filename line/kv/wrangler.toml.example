# ใช้เมื่อต้องการ deploy Worker LINE จาก Claude Code ด้วย `npx wrangler deploy` (ไม่บังคับ — วางโค้ดใน dashboard ได้เหมือนเดิม)
# คัดลอกเป็น wrangler.toml ในโฟลเดอร์นี้ แล้วใส่ KV namespace id (ดูใน Cloudflare → Workers KV → LINE_USERS)
# ค่าลับตั้งด้วย: npx wrangler secret put LINE_CHANNEL_SECRET (และ LINE_CHANNEL_TOKEN, STATS_KEY) — ห้ามเขียนค่าลับในไฟล์นี้
name = "chanat-line-webhook"
main = "worker.js"
compatibility_date = "2026-09-30"

[[kv_namespaces]]
binding = "USERS"
id = "ใส่-KV-namespace-id-ของ-LINE_USERS"

[vars]
DAILY_GROUP_PUSH = "on"

[triggers]
crons = ["0 0 * * *"]   # 07:00 น. เวลาไทย

[observability]
enabled = true
